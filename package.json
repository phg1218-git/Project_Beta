{
  "name": "project-beta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs && tsx scripts/test-confirm-payment.ts && tsx scripts/test-cancel-order.ts && tsx scripts/test-profile-validation.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test:integration": "node scripts/test-integration.mjs",
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --no-cache",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:uploads": "tsx scripts/test-product-images.ts",
    "dev:check": "next dev -p 3100"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.4.1",
    "@netlify/blobs": "^11.1.7",
    "@prisma/client": "^5.16.0",
